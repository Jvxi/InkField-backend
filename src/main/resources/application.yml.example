server:
  port: 4000
  tomcat:
    # Tomcat 线程池配置 - 性能优化
    max-threads: 200              # 最大线程数
    min-spare-threads: 20         # 最小空闲线程数
    accept-count: 100             # 等待队列长度
    connection-timeout: 10000     # 连接超时时间（10秒）
    max-connections: 8192         # 最大连接数
    # 启用 HTTP/2 支持
    protocol:
      max-http-form-post-size: 10MB

spring:
  jackson:
    serialization:
      indent-output: true
    deserialization:
      fail-on-missing-creator-properties: false
  datasource:
    # ↓↓↓ 数据库配置 - 请替换为你的实际配置 ↓↓↓
    url: jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DB_NAME?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      # 连接池配置 - 性能优化
      maximum-pool-size: 20          # 最大连接数，从默认 10 提升到 20
      minimum-idle: 5                # 最小空闲连接数
      idle-timeout: 300000           # 空闲连接超时时间（5分钟）
      connection-timeout: 10000      # 连接超时时间（10秒）
      max-lifetime: 1800000          # 连接最大生命周期（30分钟）
      leak-detection-threshold: 60000 # 连接泄漏检测阈值（60秒）
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        jdbc:
          time_zone: Asia/Shanghai
        # 优化 Hibernate 性能
        jdbc.batch_size: 50          # 批量操作大小
        jdbc.batch_versioned_data: true
        order_inserts: true          # 优化插入顺序
        order_updates: true          # 优化更新顺序
        generate_statistics: false   # 关闭统计信息以提高性能
  flyway:
    enabled: true
    baseline-on-migrate: true
  mail:
    # ↓↓↓ 邮箱 SMTP 配置 - 请替换为你的实际配置 ↓↓↓
    host: smtp.YOUR_EMAIL_PROVIDER.com
    port: 465
    username: YOUR_EMAIL@example.com
    # ↓↓↓ 在下面引号里填写「授权码」，不是邮箱登录密码 ↓↓↓
    password: "YOUR_EMAIL_AUTH_CODE"
    protocol: smtp
    default-encoding: UTF-8
    properties:
      mail:
        smtp:
          auth: true
          ssl:
            enable: true
          starttls:
            enable: false
            required: false
          connectiontimeout: 10000
          timeout: 10000
          writetimeout: 10000

novel:
  app:
    # ↓↓↓ 服务器公网地址 ↓↓↓
    public-url: http://YOUR_SERVER_IP
  auth:
    token-ttl-hours: 168
  mail:
    from: YOUR_EMAIL@example.com
    required: true
  storage:
    import-legacy-json: true

  # Story System 配置
  story-system:
    csv-path: classpath:references/csv/
    contract-cache-ttl: 3600

  # 长期记忆系统配置
  memory:
    compactor-enabled: true
    compactor-threshold: 500
    orchestrator-max-items: 30
    budget:
      write:
        max-items: 30
        working-ratio: 0.45
        episodic-ratio: 0.30
        semantic-ratio: 0.25
      review:
        max-items: 40
        working-ratio: 0.35
        episodic-ratio: 0.35
        semantic-ratio: 0.30

  # RAG 智能上下文配置
  rag:
    embed-base-url: ${EMBED_BASE_URL:}
    embed-model: ${EMBED_MODEL:text-embedding-3-small}
    embed-api-key: ${EMBED_API_KEY:}
    embed-concurrency: 64
    embed-batch-size: 64
    rerank-base-url: ${RERANK_BASE_URL:}
    rerank-model: ${RERANK_MODEL:jina-reranker-v3}
    rerank-api-key: ${RERANK_API_KEY:}
    vector-top-k: 30
    bm25-top-k: 20
    rerank-top-n: 10
    rrf-k: 60
    graph-rag-enabled: false
    graph-rag-expand-hops: 1
    graph-rag-max-expanded-entities: 30
    vector-full-scan-max-vectors: 500

  # 追读力系统配置
  reading-power:
    pacing-words-per-point-excellent: 1000
    pacing-words-per-point-good: 1500
    foreshadowing-urgency-pending-high: 100
    foreshadowing-urgency-pending-medium: 50
    foreshadowing-urgency-threshold-show: 60

# 性能监控配置
management:
  endpoints:
    web:
      exposure:
        include: health,metrics,prometheus
  endpoint:
    health:
      show-details: when-authorized
  metrics:
    tags:
      application: inkfield-backend
    distribution:
      percentiles-histogram:
        http.server.requests: true
      percentiles:
        http.server.requests: 0.5, 0.95, 0.99

# 日志配置 - 性能优化
logging:
  level:
    root: INFO
    com.novelstudio.backend: INFO
    org.springframework.web: WARN
    org.hibernate.SQL: WARN
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
  file:
    name: logs/inkfield-backend.log
    max-size: 10MB
    max-history: 30
